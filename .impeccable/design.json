      },
      "stat": {
        "value": "0.25em",
        "purpose": "Libellés stat : mode du récap, BILLE BLANCHE, NOM / DISTANCE au-dessus d’une valeur, libellés du récap, ★ RECORD, ESPACE."
      }
    },
    "gradients": [
      {
        "name": "--gradient-blue",
        "value": "linear-gradient(160deg, #2E8FDB 0%, #0573BB 100%)",
        "purpose": "LE bleu : tuiles disponibles, CTA accent, CTA de réglage, CTA de barre basse."
      },
      {
        "name": "--gradient-neutral",
        "value": "linear-gradient(160deg, #3A4049 0%, #262A31 100%)",
        "purpose": "CTA neutres opaques : ANNULER, secondaire de pop-up, PASSER LE TOUR."
      },
      {
        "name": "--gradient-red",
        "value": "linear-gradient(160deg, #E2515B 0%, #D0343F 100%)",
        "purpose": "DÉMARRER, seul CTA rouge."
      },
      {
        "name": "--gradient-panel",
        "value": "linear-gradient(160deg, #3A3F49 0%, #23262C 100%)",
        "purpose": "Colonne centrale du paramétrage."
      },
      {
        "name": "--gradient-bg",
        "value": "linear-gradient(160deg, #2A2E35 0%, #111317 55%, #000000 100%)",
        "purpose": "Fond de tous les écrans hors jeu."
      },
      {
        "name": "--gradient-tile-quilles",
        "value": "linear-gradient(160deg, #0668AD 0%, #033F6B 100%)",
        "purpose": "Tuile BIENTÔT Quilles."
      },
      {
        "name": "--gradient-tile-casin",
        "value": "linear-gradient(160deg, #05508A 0%, #022B4D 100%)",
        "purpose": "Tuile BIENTÔT Casin."
      },
      {
        "name": "--gradient-field",
        "value": "linear-gradient(160deg, #454A54 0%, #1A1D22 100%)",
        "purpose": "DÉCLARÉ, NON CONSOMMÉ : ancien fond de champ de pop-up, à supprimer."
      }
    ],
    "shadows": [
      {
        "name": "key-relief",
        "value": "inset 0 1px 0 rgba(255,255,255,0.10), 0 2px 0 rgba(0,0,0,0.45)",
        "purpose": "Relief des touches de clavier ; disparaît à l’appui (la touche s’enfonce)."
      },
      {
        "name": "key-relief-active",
        "value": "inset 0 1px 0 rgba(255,255,255,0.06)",
        "purpose": "Touche enfoncée, avec translateY(1px)."
      },
      {
        "name": "light-edge-start",
        "value": "inset 0 1px 0 rgba(255,255,255,0.25)",
        "purpose": "Filet de lumière de DÉMARRER."
      },
      {
        "name": "light-edge-field",
        "value": "inset 0 1px 0 rgba(255,255,255,0.35)",
        "purpose": "Filet de lumière des champs de paramétrage."
      },
      {
        "name": "popup",
        "value": "0 32px 80px rgba(0,0,0,0.65)",
        "purpose": "Carte de toute pop-up ; la seule ombre diffuse du produit."
      }
    ],
    "motion": [
      {
        "name": "--animate-input-flash",
        "value": "input-flash 120ms ease-out forwards (opacity 1 → 0)",
        "purpose": "Accusé de frappe, voile noir 25 % sur la valeur qui change. Coupé sous reduced-motion (avec opacity:0 forcé)."
      },
      {
        "name": "--animate-input-reject",
        "value": "input-reject 180ms ease-out (scale 1 → 1.12 → 1)",
        "purpose": "Refus d’une frappe au plafond ; jamais de message. Coupé sous reduced-motion."
      },
      {
        "name": "--animate-input-countdown",
        "value": "input-countdown 3000ms linear forwards (scaleX 0 → 1)",
        "purpose": "Barre de rebours de l’auto-validation sous VALIDER. Porteuse d’information : SURVIT à reduced-motion."
      },
      {
        "name": "shot-clock",
        "value": "transition stroke-dashoffset, stroke, color 1000ms linear",
        "purpose": "Le chrono se vide en continu, calé sur le tick. Porteur d’information : survit à reduced-motion."
      },
      {
        "name": "key-press",
        "value": "transition all 75ms",
        "purpose": "Enfoncement de touche. Tous les autres retours d’appui sont instantanés (brightness sans transition)."
      },
      {
        "name": "rest",
        "value": "none",
        "purpose": "Rien ne bouge au repos : l’accueil est l’écran de veille."
      }
    ],
    "breakpoints": [
      {
        "name": "md",
        "value": "768px"
      },
      {
        "name": "lg",
        "value": "1280px"
      },
      {
        "name": "player-card @container",
        "value": "420px"
      },
      {
        "name": "format-reference",
        "value": "1920×1080"
      },
      {
        "name": "format-travail",
        "value": "1180×733"
      },
      {
        "name": "format-plancher",
        "value": "1133×744"
      },
      {
        "name": "--spacing (grille fluide)",
        "value": "clamp(8px, 0.678vw, 13px)"
      },
      {
        "name": "--size-* (13 tailles de boîte dérivées de la grille, DESIGN.md › spacing)",
        "value": "calc(var(--spacing) * n) : touch-target 11.25, sidebar 15, start-button 13.75, key-numeric 7.5, key-alpha 7.125, field-min 16.25, field-max 27.5, tile-min 22.5, popup-decision 72, popup-pad 64, popup-alpha 96 ; pad-min = key-numeric × 4 + 6 unités, alpha-min = key-alpha × 6 + 5 unités. Lues par le gabarit en w-(--size-…) / max-w-(--size-…) / min-h-(--size-…)."
      }
    ]
  },
  "components": [
    {
      "name": "CTA accent (pop-up)",
      "kind": "button",
      "refersTo": "button-accent",
      "description": "CTA principal de toute pop-up (VALIDER, RÉGLER LA DISTANCE, choix de cadre) : dégradé bleu du produit, rayon de touche.",
      "html": "<button class=\"ds-btn-accent\">VALIDER</button>",
      "css": ".ds-btn-accent{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--size-touch-target);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-label);font-weight:900;text-transform:uppercase;color:#fff;border:none;cursor:pointer;user-select:none;touch-action:manipulation;background:var(--gradient-blue);border-radius:var(--radius-key);padding:0 16px}.ds-btn-accent:hover{filter:brightness(1.05)}.ds-btn-accent:active{filter:brightness(.9)}.ds-btn-accent:focus-visible{outline:4px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "CTA neutre (pop-up)",
      "kind": "button",
      "refersTo": "button-neutral",
      "description": "Retour de toute pop-up (ANNULER) et PASSER LE TOUR : ardoise opaque, sans contour, jamais rouge.",
      "html": "<button class=\"ds-btn-neutral\">ANNULER</button>",
      "css": ".ds-btn-neutral{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--size-touch-target);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-label);font-weight:900;text-transform:uppercase;color:#fff;border:none;cursor:pointer;user-select:none;touch-action:manipulation;background:var(--gradient-neutral);border-radius:var(--radius-key);padding:0 16px}.ds-btn-neutral:active{filter:brightness(1.25)}.ds-btn-neutral:focus-visible{outline:4px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "DÉMARRER",
      "kind": "button",
      "refersTo": "button-start",
      "description": "Le seul CTA rouge : l’action qui engage la partie. Chevron nu à gauche, filet de lumière, 110 px, angles vifs.",
      "html": "<button class=\"ds-btn-start\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg><span>DÉMARRER</span></button>",
      "css": ".ds-btn-start{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--size-start-button);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-start-button);font-weight:900;text-transform:uppercase;color:#fff;border:none;cursor:pointer;user-select:none;touch-action:manipulation;gap:calc(var(--spacing) * 2);background:var(--gradient-red);border-radius:var(--radius-cta);padding:0 calc(var(--spacing) * 2);letter-spacing:var(--tracking-label);box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}.ds-btn-start svg{width:40px;height:40px;flex-shrink:0}.ds-btn-start:active{filter:brightness(.9)}"
    },
    {
      "name": "CTA de réglage",
      "kind": "button",
      "refersTo": "button-setup",
      "description": "Réglage retouchable du paramétrage (CHANGER DE BILLE, CHANGER DE CÔTÉ) : bleu, angles vifs, picto en ligne.",
      "html": "<button class=\"ds-btn-setup\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m16 3 4 4-4 4\"/><path d=\"M20 7H4\"/><path d=\"m8 21-4-4 4-4\"/><path d=\"M4 17h16\"/></svg><span>CHANGER DE CÔTÉ</span></button>",
      "css": ".ds-btn-setup{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--size-touch-target);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-label);font-weight:900;text-transform:uppercase;color:#fff;border:none;cursor:pointer;user-select:none;touch-action:manipulation;gap:16px;background:var(--gradient-blue);border-radius:var(--radius-cta);padding:0 16px;font-size:var(--text-label);font-weight:700}.ds-btn-setup svg{width:24px;height:24px;flex-shrink:0}.ds-btn-setup:active{filter:brightness(.9)}"
    },
    {
      "name": "Touche de clavier",
      "kind": "custom",
      "refersTo": "key",
      "description": "Plaque anthracite en relief qui s’enfonce à l’appui. Partagée par les pavés numérique et alphabétique.",
      "html": "<div class=\"ds-keys\"><button class=\"ds-key\">1</button><button class=\"ds-key\">2</button><button class=\"ds-key\">3</button></div>",
      "css": ".ds-keys{display:grid;grid-template-columns:repeat(3,1fr);gap:calc(var(--spacing) * 2);max-width:320px}.ds-key{display:flex;align-items:center;justify-content:center;min-height:var(--size-key-numeric);min-width:var(--size-key-numeric);background:var(--color-key);color:#fff;border:none;border-radius:var(--radius-key);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-key-numeric);font-weight:600;letter-spacing:-.025em;line-height:1;box-shadow:inset 0 1px 0 rgba(255,255,255,.10),0 2px 0 rgba(0,0,0,.45);transition:all 75ms;cursor:pointer;user-select:none}.ds-key:active{transform:translateY(1px);background:var(--color-key-active);box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}.ds-key:disabled{opacity:.3}"
    },
    {
      "name": "Picto d’action (barre basse)",
      "kind": "nav",
      "refersTo": "icon-action",
      "description": "Commande secondaire du scoreboard : picto 32 px au-dessus d’un libellé court, surface voilée, filet, 90 × 90 px.",
      "html": "<button class=\"ds-icon-action\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10.5a5.5 5.5 0 0 1 0 11H11\"/></svg><span>ANNULER</span></button>",
      "css": ".ds-icon-action{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-width:var(--size-touch-target);min-height:var(--size-touch-target);padding:0 8px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-cta);color:#fff;font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-picto);font-weight:700;text-transform:uppercase;line-height:1.25;cursor:pointer;user-select:none}.ds-icon-action svg{width:32px;height:32px}.ds-icon-action:active{background:rgba(255,255,255,.15)}.ds-icon-action:disabled{opacity:.3}"
    },
    {
      "name": "Tuile de mode",
      "kind": "card",
      "refersTo": "mode-tile",
      "description": "Tuile jointive d’accueil : titre 900 en haut à gauche, flèche nue en bas à droite, dégradé bleu unique ; BIENTÔT atténue le fond à 45 % et ajoute un badge.",
      "html": "<div class=\"ds-tiles\"><button class=\"ds-tile\"><span class=\"ds-tile-bg\"></span><span class=\"ds-tile-title\">3 BANDES</span><svg class=\"ds-tile-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button><button class=\"ds-tile ds-tile--soon\" disabled><span class=\"ds-tile-bg ds-tile-bg--quilles\"></span><span class=\"ds-tile-title\">QUILLES</span><span class=\"ds-tile-badge\">BIENTÔT</span></button></div>",
      "css": ".ds-tiles{display:grid;grid-template-columns:1fr 1fr;max-width:520px}.ds-tiles>.ds-tile+.ds-tile{border-left:1px solid var(--color-border)}.ds-tile{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:space-between;min-height:var(--size-tile-min);padding:calc(var(--spacing) * 2);background:none;border:none;text-align:left;color:#fff;cursor:pointer;user-select:none}.ds-tile-bg{position:absolute;inset:0;z-index:-1;background:var(--gradient-blue)}.ds-tile-bg--quilles{background:var(--gradient-tile-quilles)}.ds-tile--soon .ds-tile-bg{opacity:.45}.ds-tile-title{font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-title);font-weight:900;text-transform:uppercase;line-height:1}.ds-tile-arrow{width:40px;height:40px;align-self:flex-end}.ds-tile-badge{align-self:flex-end;background:rgba(255,255,255,.15);padding:4px 12px;font-family:system-ui,sans-serif;font-size:var(--text-stat);font-weight:700}.ds-tile:not(.ds-tile--soon):hover{filter:brightness(1.1)}.ds-tile:not(.ds-tile--soon):active{filter:brightness(1.25)}"
    },
    {
      "name": "Barre latérale",
      "kind": "nav",
      "refersTo": "sidebar-item",
      "description": "Colonne de 120 px collée au bord : en-tête rouge coupé en biais, items picto + libellé, sortie isolée en bas. Contextuelle, nourrie par l’écran.",
      "html": "<aside class=\"ds-sidebar\"><div class=\"ds-sidebar-header\"><span class=\"ds-sidebar-cut\"></span><span class=\"ds-sidebar-fold\"></span><span class=\"ds-sidebar-logo\">1S</span><span class=\"ds-sidebar-brand\">1Score</span></div><button class=\"ds-sidebar-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 12H5\"/><path d=\"m12 19-7-7 7-7\"/></svg><span>RETOUR</span></button><button class=\"ds-sidebar-item ds-sidebar-item--exit\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg><span>ANNULER</span></button></aside>",
      "css": ".ds-sidebar{display:flex;flex-direction:column;gap:calc(var(--spacing) * 1.5);width:var(--size-sidebar);height:420px;padding-bottom:24px;background:var(--color-sidebar);border-right:1px solid var(--color-border)}.ds-sidebar-header{position:relative;isolation:isolate;display:flex;flex-direction:column;align-items:center;gap:4px;height:120px;padding-top:16px;flex-shrink:0}.ds-sidebar-cut,.ds-sidebar-fold{position:absolute;inset:0;z-index:-1;background:var(--color-brand-red)}.ds-sidebar-cut{clip-path:polygon(0 0,100% 0,100% 92%,0 72%)}.ds-sidebar-fold{opacity:.35;clip-path:polygon(0 72%,100% 92%,100% 100%,0 84%)}.ds-sidebar-logo{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:10px;background:#222;color:#fff;font-weight:900;font-family:system-ui,sans-serif}.ds-sidebar-brand{color:#fff;font-family:system-ui,sans-serif;font-size:var(--text-picto);font-weight:900;letter-spacing:var(--tracking-title)}.ds-sidebar-item{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:var(--size-touch-target);width:100%;padding:0 4px;background:none;border:none;color:#fff;font-family:system-ui,sans-serif;font-size:var(--text-picto);font-weight:700;text-transform:uppercase;line-height:1.25;text-align:center;cursor:pointer}.ds-sidebar-item svg{width:32px;height:32px}.ds-sidebar-item--exit{margin-top:auto}"
    },
    {
      "name": "Carte joueur (blanche)",
      "kind": "card",
      "refersTo": "player-card-white",
      "description": "Aplat plein à encre noire : bandeau NOM | DISTANCE puis RESTANT | MOY · SÉRIE, score géant, pied − / série / +. Liseré rouge vif quand le joueur a la main.",
      "html": "<div class=\"ds-player ds-player--active\"><div class=\"ds-player-band\"><div class=\"ds-player-row\"><span class=\"ds-player-name\">MICHEL</span><span class=\"ds-player-num\">40</span></div><div class=\"ds-player-row\"><span class=\"ds-player-num\">28</span><span class=\"ds-player-stats\"><span><b>MOY</b> 0.750</span><span><b>SÉRIE</b> 4</span></span></div></div><div class=\"ds-player-score\">12</div><div class=\"ds-player-foot\"><button class=\"ds-player-adjust\">−</button><span class=\"ds-player-series\">3</span><button class=\"ds-player-adjust\">+</button></div><span class=\"ds-player-ring\"></span></div>",
      "css": ".ds-player{position:relative;display:flex;flex-direction:column;width:360px;height:300px;overflow:hidden;background:var(--color-player-white);color:var(--color-on-player-white);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;user-select:none}.ds-player-band{display:flex;flex-direction:column;gap:8px;padding:20px 24px;background:var(--color-panel-white-band)}.ds-player-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px}.ds-player-name{font-size:var(--text-label);font-weight:900;text-transform:uppercase;line-height:1.25}.ds-player-num{font-size:var(--text-label);font-weight:900;font-variant-numeric:tabular-nums;line-height:1}.ds-player-stats{margin-left:auto;display:flex;gap:16px;font-size:var(--text-stat);font-weight:900;font-variant-numeric:tabular-nums}.ds-player-stats b{font-weight:700;opacity:.6;margin-right:4px}.ds-player-score{flex:1;display:flex;align-items:center;justify-content:center;font-size:var(--text-score-1);font-weight:900;line-height:1;font-variant-numeric:tabular-nums}.ds-player-foot{display:flex;align-items:center;justify-content:space-between;padding:0 16px 16px}.ds-player-adjust{display:flex;align-items:center;justify-content:center;min-width:var(--size-touch-target);min-height:var(--size-touch-target);background:rgba(0,0,0,.08);border:none;border-radius:var(--radius-cta);font-size:var(--text-adjust);font-weight:900;opacity:.6;cursor:pointer}.ds-player-adjust:active{background:rgba(0,0,0,.16);opacity:1}.ds-player-series{font-size:var(--text-series);font-weight:900;color:var(--color-brand-red);font-variant-numeric:tabular-nums;line-height:1}.ds-player-ring{position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 0 8px var(--color-turn-active)}.ds-player:not(.ds-player--active) .ds-player-ring{display:none}"
    },
    {
      "name": "Carte de pop-up",
      "kind": "card",
      "refersTo": "popup-card",
      "description": "Le patron des quatre pop-ups : voile noir 25 % sans flou, carte sombre à 12 px, titre centré, pied ANNULER (1/3) + VALIDER. Jamais de croix.",
      "html": "<div class=\"ds-veil\"><div class=\"ds-popup\"><h2 class=\"ds-popup-title\">DISTANCE MANQUANTE</h2><div class=\"ds-popup-foot\"><button class=\"ds-popup-secondary\">ANNULER</button><button class=\"ds-popup-primary\">RÉGLER LA DISTANCE</button></div></div></div>",
      "css": ".ds-veil{display:flex;align-items:center;justify-content:center;padding:32px;background:var(--color-bg)}.ds-veil{background:linear-gradient(rgba(0,0,0,.25),rgba(0,0,0,.25)),var(--gradient-bg)}.ds-popup{display:flex;flex-direction:column;gap:24px;width:100%;max-width:560px;padding:24px;background:color-mix(in srgb,var(--color-bg) 95%,transparent);border:1px solid rgba(255,255,255,.12);border-radius:var(--radius-modal);box-shadow:0 32px 80px rgba(0,0,0,.65)}.ds-popup-title{margin:0;text-align:center;color:#fff;font-family:system-ui,sans-serif;font-size:var(--text-label);font-weight:900;letter-spacing:.1em;text-transform:uppercase}.ds-popup-foot{display:flex;gap:16px}.ds-popup-secondary,.ds-popup-primary{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--size-touch-target);font-family:system-ui,Avenir,Helvetica,Arial,sans-serif;font-size:var(--text-label);font-weight:900;text-transform:uppercase;color:#fff;border:none;cursor:pointer;user-select:none;touch-action:manipulation;border-radius:var(--radius-key);padding:0 16px}.ds-popup-secondary{width:33%;background:var(--gradient-neutral)}.ds-popup-primary{flex:1;background:var(--gradient-blue)}.ds-popup-primary:active{filter:brightness(.9)}.ds-popup-secondary:active{filter:brightness(1.25)}"
    },
    {
      "name": "Bandeau de récap",
      "kind": "custom",
      "refersTo": "summary-banner",
      "description": "Bande claire échancrée en biais autour du VS : NOM | distance de chaque côté, en noir bleuté sur blanc cassé. Coupe en biais signature.",
      "html": "<header class=\"ds-banner\"><div class=\"ds-banner-side ds-banner-side--left\"><span class=\"ds-banner-name\">MICHEL</span><span class=\"ds-banner-sep\"></span><span class=\"ds-banner-num\">40</span></div><div class=\"ds-banner-vs\"><span class=\"ds-banner-mode\">LIBRE</span><span class=\"ds-banner-vs-word\">VS</span></div><div class=\"ds-banner-side ds-banner-side--right\"><span class=\"ds-banner-num\">40</span><span class=\"ds-banner-sep\"></span><span class=\"ds-banner-name\">DIDIER</span></div></header>",
